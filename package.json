{
  "name": "programming.in.th",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": "^24.11"
  },
  "lint-staged": {
    "*.{json,md,yaml,css,scss}": [
      "prettier --write"
    ],
    "*.{js,mjs,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev --turbopack",
    "build": "prisma generate && rm -rf .next/standalone && next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "cd .next/standalone && dotenv -e ../../.env -- node server.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json,css,scss,md,yml}\" && eslint src --fix",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "prepare": "husky",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@next/bundle-analyzer": "15.5.28",
    "@prisma/client": "6.19.3",
    "@smithy/node-http-handler": "^4.13.0",
    "@supabase/realtime-js": "2.118.0",
    "@tanstack/react-table": "8.21.3",
    "@uiw/codemirror-theme-dracula": "4.25.12",
    "@uiw/react-codemirror": "4.25.12",
    "@visx/group": "3.12.0",
    "@visx/shape": "3.12.0",
    "@visx/text": "3.12.0",
    "axios": "1.21.0",
    "clsx": "2.1.1",
    "csstype": "3.2.3",
    "dayjs": "1.11.23",
    "fuse.js": "7.5.0",
    "katex": "0.16.47",
    "motion": "12.43.0",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "prism-react-renderer": "1.3.5",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-countup": "6.5.3",
    "react-dom": "19.3.1",
    "react-dropzone": "14.4.1",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1",
    "react-infinite-scroll-component": "6.1.1",
    "react-table": "7.8.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@octokit/types": "18.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-table": "7.7.20",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.2",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "prisma": "6.19.3",
    "prisma-dbml-generator": "0.12.0",
    "sass": "1.107.0",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.32",
      "cross-spawn@<7.0.6": "7.0.6",
      "tmp@<0.2.7": "0.2.7"
    }
  }
}
